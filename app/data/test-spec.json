  "hiddenRules": {
    "ROOT": {"requiredFlags": ["ROOT"], "conditions": [{"dimension": "SN", "op": ">=", "value": 4}, {"dimension": "JP", "op": ">=", "value": 2}], "minimumConfidence": 0.62},
    "SHELL": {"requiredFlags": ["SHELL"], "conditions": [{"dimension": "TF", "op": "<=", "value": -13}, {"dimension": "TR", "op": "<=", "value": -7}], "minimumConfidence": 0.62},
    "HALL-C": {"requiredFlags": ["HALL_C"], "conditions": [{"dimension": "TR", "op": ">=", "value": 6}, {"dimension": "TF", "op": ">=", "value": 2}], "minimumConfidence": 0.62}
